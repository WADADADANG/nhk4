{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nhk4",
  "version": "4.0.0",
  "identifier": "com.nhk4.app",
  "build": {
    "frontendDist": "public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "NHK4",
        "url": "http://127.0.0.1:3088/launcher",
        "width": 1280,
        "height": 800,
        "minWidth": 980,
        "minHeight": 650,
        "decorations": false,
        "transparent": false
      },
      {
        "label": "overlay",
        "title": "NHK4 HUD Overlay",
        "url": "http://127.0.0.1:3088/launcher/overlay.html",
        "width": 210,
        "height": 180,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "resizable": false,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
